# =============================================================================
# SEVA - Normalización de finales de línea
# =============================================================================
# Evita conflictos CRLF/LF entre colaboradores en Windows, Linux y macOS.
# =============================================================================

# Normaliza a LF en el repositorio; Git convierte a CRLF en Windows al hacer checkout
* text=auto eol=lf

# --- Código fuente y documentación (texto, LF) ---
*.php   text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf

# --- Archivos de servidor (deben conservar sus finales) ---
.htaccess text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# --- Binarios (nunca se transforman) ---
*.jpg  binary
*.jpeg binary
*.png  binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.mp4  binary
*.webm binary

# --- Diferencias legibles en GitHub ---
*.md   diff=markdown
*.sql  diff
