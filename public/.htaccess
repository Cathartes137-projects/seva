# =============================================================================
# SEVA - Configuración Apache del proyecto
# Fase 4: cabeceras de seguridad, CSP, HTTPS/HSTS y ocultación de errores.
# =============================================================================
# Este archivo se aplica en C:/xampp/htdocs/seva/public (AllowOverride All).
# Modulos requeridos: mod_headers y mod_rewrite (cargados por defecto en XAMPP).
# =============================================================================

# --- Sin listado de directorios ---
Options -Indexes

# --- Codificacion por defecto ---
AddDefaultCharset UTF-8

# =============================================================================
# 1. OCULTACION DE ERRORES PHP (D21)
# =============================================================================
# display_errors Off: no se filtran mensajes tecnicos al usuario.
# log_errors On: el diagnostico se conserva en el log configurado en php.ini.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# =============================================================================
# 2. CABECERAS DE SEGURIDAD Y CSP (D11)
# =============================================================================
<IfModule mod_headers.c>
    # Evita la interpretacion incorrecta de tipos MIME
    Header always set X-Content-Type-Options "nosniff"
    # No permite incrustar el sitio en marcos (anti clickjacking)
    Header always set X-Frame-Options "DENY"
    # Limita la informacion de referencia enviada a terceros
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Restringe APIs del navegador no utilizadas
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    # Content-Security-Policy inicial.
    #   script-src 'unsafe-inline'  -> scripts inline y onerror del dashboard
    #   style-src  'unsafe-inline'  -> bloques <style> y atributos style=
    #   https://fonts.googleapis.com / gstatic.com -> Google Fonts
    #   img-src data:               -> fallback SVG del dashboard
    # Deuda documentada: sustituir 'unsafe-inline' por nonces y extraer el JS.
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self'"

    # Se elimina la firma del servidor que expone la version de PHP (D21).
    # PHP anade X-Powered-By en la fase de respuesta; se elimina tanto en la
    # tabla de salida normal como en la de siempre para cubrir las respuestas
    # 200 y las de error.
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# =============================================================================
# 3. REDIRECCION HTTPS Y HSTS (D12)
# =============================================================================
# Redireccion 301 a HTTPS SOLO fuera de localhost/127.0.0.1, de modo que en el
# entorno local de XAMPP no se active y en produccion funcione automaticamente.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} !^localhost(:[0-9]+)?$ [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# HSTS: solo se emite cuando la peticion ya viaja por HTTPS (no afecta a local).
# En produccion, valorar anadir "; includeSubDomains" una vez verificado HTTPS.
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
</IfModule>

# =============================================================================
# 4. PROTECCION DE ARCHIVOS SENSIBLES
# =============================================================================
# Nunca servir secretos, volcados, logs ni metadatos de git.
<FilesMatch "(^\.env.*|.*\.(sql|log|ini|bak|old|sh|yml|yaml)|^\.git.*)$">
    Require all denied
</FilesMatch>

# Bloqueo explicito del contenido de .git
RedirectMatch 404 /\.git
