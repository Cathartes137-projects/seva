# =============================================================================
# SEVA - Archivos excluidos del control de versiones
# =============================================================================

# --- Secretos y configuración local ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Volcados de base de datos con datos reales ---
# El esquema y los datos de demostración sí se versionan en DataBase/
*.dump
*.bak
backup_*.sql
*_backup.sql

# --- Logs ---
*.log
logs/
error_log

# --- Temporales y de editor ---
*.tmp
*.temp
*.swp
*~
.~*
Thumbs.db
Desktop.ini
.DS_Store

# --- Dependencias (si en el futuro se incorporan gestores) ---
vendor/
node_modules/

# --- Entornos de IDE ---
.vscode/
.idea/
*.sublime-*
