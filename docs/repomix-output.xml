<script>
(function(){
    /* ---------- Menú móvil ---------- */
    const sidebar = document.getElementById('sidebar');
    const fondoMovil = document.getElementById('fondo-sidebar-movil');
    const btnMenu = document.getElementById('btn-menu');

    function abrirSidebar(){
        sidebar.classList.add('abierto');
        fondoMovil.classList.add('abierto');
        btnMenu.setAttribute('aria-expanded', 'true');
    }
    function cerrarSidebar(){
        sidebar.classList.remove('abierto');
        fondoMovil.classList.remove('abierto');
        btnMenu.setAttribute('aria-expanded', 'false');
    }
    btnMenu.addEventListener('click', function(){
        sidebar.classList.contains('abierto') ? cerrarSidebar() : abrirSidebar();
    });
    fondoMovil.addEventListener('click', cerrarSidebar);
    sidebar.querySelectorAll('a').forEach(a => a.addEventListener('click', cerrarSidebar));

    /* ---------- Menús desplegables (notificaciones / perfil) ---------- */
    function configurarDesplegable(btnId, menuId){
        const btn = document.getElementById(btnId);
        const menu = document.getElementById(menuId);
        btn.addEventListener('click', function(e){
            e.stopPropagation();
            const abierto = menu.classList.toggle('abierto');
            btn.setAttribute('aria-expanded', abierto ? 'true' : 'false');
            document.querySelectorAll('.menu-desplegable').forEach(m => { if (m !== menu) m.classList.remove('abierto'); });
        });
    }
    configurarDesplegable('btn-notificaciones', 'menu-notificaciones');
    configurarDesplegable('btn-perfil', 'menu-perfil');

    document.addEventListener('click', function(){
        document.querySelectorAll('.menu-desplegable').forEach(m => m.classList.remove('abierto'));
    });

    /* ---------- Buscador ---------- */
    document.getElementById('form-buscar').addEventListener('submit', function(e){
        e.preventDefault();
        window.location.href = 'login.php';
    });

    /* ---------- Modal "Ver cómo funciona" ---------- */
    const fondoModal = document.getElementById('fondo-modal');
    document.getElementById('btn-como-funciona').addEventListener('click', function(){
        fondoModal.classList.add('abierto');
    });
    document.getElementById('cerrar-modal').addEventListener('click', function(){
        fondoModal.classList.remove('abierto');
    });
    fondoModal.addEventListener('click', function(e){
        if (e.target === fondoModal) fondoModal.classList.remove('abierto');
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') fondoModal.classList.remove('abierto');
    });

    /* ---------- Resaltado de navegación al hacer scroll ---------- */
    const enlacesNav = document.querySelectorAll('.nav-principal a[data-nav]');
    const secciones = ['inicio', 'cursos'].map(id => document.getElementById(id)).filter(Boolean);
    const observador = new IntersectionObserver(function(entradas){
        entradas.forEach(function(entrada){
            if (entrada.isIntersecting){
                enlacesNav.forEach(a => a.classList.remove('activo'));
                const activo = document.querySelector('.nav-principal a[data-nav="' + entrada.target.id + '"]');
                if (activo) activo.classList.add('activo');
            }
        });
    }, { rootMargin: '-40% 0px -50% 0px' });
    secciones.forEach(s => observador.observe(s));

    /* ---------- Contadores animados ---------- */
    function animarContador(el, destino, sufijo, duracion){
        sufijo = sufijo || '';
        duracion = duracion || 1400;
        const inicio = performance.now();
        function paso(ahora){
            const progreso = Math.min((ahora - inicio) / duracion, 1);
            const valor = Math.floor(progreso * destino);
            el.textContent = valor.toLocaleString('es-CO') + sufijo;
            if (progreso < 1) requestAnimationFrame(paso);
        }
        requestAnimationFrame(paso);
    }

    const contadorEstudiantes = document.getElementById('contador-estudiantes');
    const statEstudiantes = document.getElementById('stat-estudiantes');
    const statPrecision = document.getElementById('stat-precision');
    const statLecciones = document.getElementById('stat-lecciones');

    let contadoHero = false;
    const heroObs = new IntersectionObserver(function(entradas){
        entradas.forEach(function(entrada){
            if (entrada.isIntersecting && !contadoHero){
                contadoHero = true;
                animarContador(contadorEstudiantes, 5000, '+');
            }
        });
    }, { threshold: 0.4 });
    heroObs.observe(contadorEstudiantes);

    let contadoStats = false;
    const statsObs = new IntersectionObserver(function(entradas){
        entradas.forEach(function(entrada){
            if (entrada.isIntersecting && !contadoStats){
                contadoStats = true;
                animarContador(statEstudiantes, 5000, '+');
                animarContador(statPrecision, 98, '%');
                animarContador(statLecciones, 120, '+');
            }
        });
    }, { threshold: 0.3 });
    statsObs.observe(document.querySelector('.fila-stats'));

    /* ---------- Precisión "en vivo" del hand-tracking (elemento de firma) ---------- */
    const valorPrecision = document.getElementById('valor-precision');
    const barraPrecision = document.getElementById('barra-precision');
    setInterval(function(){
        const nuevo = Math.floor(95 + Math.random() * 5); // 95–99
        valorPrecision.textContent = nuevo + '%';
        barraPrecision.style.width = nuevo + '%';
    }, 2600);
})();
</script>
