        gap:0.6rem;
        font-family:'Baloo 2', sans-serif;
        font-weight:800;
        font-size:1.4rem;
        color:#fff;
        text-decoration:none;
        margin-bottom:2.2rem;
    }
    .sidebar .marca .punto{
        width:11px; height:11px; border-radius:50%;
        background:var(--verde-seva);
        display:inline-block;
        box-shadow:0 0 0 5px rgba(40,167,69,0.18);
    }

    .nav-principal{
        display:flex;
        flex-direction:column;
        gap:0.3rem;
        list-style:none;
        padding:0;
        margin:0;
        flex:1;
    }
    .nav-principal a{
        display:flex;
        align-items:center;
        gap:0.75rem;
        text-decoration:none;
        color:#C7D2EE;
        font-weight:600;
        font-size:0.98rem;
        padding:0.7rem 0.85rem;
        border-radius:0.7rem;
        transition:background 0.15s ease, color 0.15s ease;
    }
    .nav-principal a svg{ flex-shrink:0; opacity:0.85; }
    .nav-principal a:hover{
        background:rgba(255,255,255,0.06);
        color:#fff;
    }
    .nav-principal a.activo{
        background:var(--azul-seva);
        color:#fff;
        box-shadow:0 8px 20px -8px rgba(0,86,179,0.7);
    }
    .nav-principal a.activo svg{ opacity:1; }

    .sidebar-auth{
        display:flex;
        flex-direction:column;
        gap:0.7rem;
        padding-top:1.4rem;
        border-top:1px solid rgba(255,255,255,0.1);
    }
    .btn{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:0.5rem;
        font-family:'Inter', sans-serif;
        font-weight:700;
        font-size:0.95rem;
        padding:0.75rem 1.1rem;
        border-radius:0.75rem;
        border:none;
        cursor:pointer;
        text-decoration:none;
        transition:transform 0.12s ease, background 0.15s ease, box-shadow 0.15s ease;
    }
    .btn:active{ transform:translateY(1px); }

    .btn-contorno-claro{
        background:transparent;
        color:#fff;
        border:1.5px solid rgba(255,255,255,0.4);
    }
    .btn-contorno-claro:hover{ background:rgba(255,255,255,0.08); border-color:#fff; }

    .btn-azul{
        background:var(--azul-seva);
        color:#fff;
    }
    .btn-azul:hover{ background:#00478f; }

    .btn-verde{
        background:var(--verde-seva);
        color:#fff;
    }
    .btn-verde:hover{ background:#218838; box-shadow:0 10px 24px -10px rgba(40,167,69,0.6); }

    .btn-contorno-azul{
        background:#fff;
        color:var(--azul-seva);
        border:1.5px solid var(--azul-seva);
    }
    .btn-contorno-azul:hover{ background:var(--azul-claro); }

    /* =================== MOBILE TOGGLE =================== */
    .btn-menu{
        display:none;
        background:var(--ink);
        color:#fff;
        border:none;
        width:44px; height:44px;
        border-radius:0.6rem;
        align-items:center;
        justify-content:center;
        cursor:pointer;
    }

    .fondo-sidebar-movil{
        display:none;
        position:fixed;
        inset:0;
        background:rgba(11,27,51,0.55);
        z-index:40;
    }

    /* =================== MAIN =================== */
    .principal{ display:flex; flex-direction:column; min-width:0; }

    /* --- Topbar --- */
    .topbar{
        display:flex;
        align-items:center;
        gap:1.2rem;
        padding:1.1rem 2.2rem;
        background:var(--paper);
        border-bottom:1px solid var(--linea);
        position:sticky;
        top:0;
        z-index:30;
    }
    .buscador{
        flex:1;
        max-width:480px;
        position:relative;
    }
    .buscador svg{
        position:absolute;
        left:0.9rem; top:50%;
        transform:translateY(-50%);
        color:var(--muted);
    }
    .buscador input{
        width:100%;
        padding:0.75rem 1rem 0.75rem 2.6rem;
        border:1.5px solid var(--linea);
        border-radius:0.8rem;
        font-family:'Inter', sans-serif;
        font-size:0.95rem;
        background:var(--bg);
        color:var(--texto);
        transition:border-color 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
    }
    .buscador input::placeholder{ color:var(--muted); }
    .buscador input:focus{
        outline:none;
        border-color:var(--azul-seva);
        background:#fff;
        box-shadow:0 0 0 4px rgba(0,86,179,0.12);
    }

    .topbar-derecha{
        display:flex;
        align-items:center;
        gap:0.7rem;
        margin-left:auto;
        position:relative;
    }
    .icono-topbar{
        position:relative;
        width:44px; height:44px;
        border-radius:0.7rem;
        border:1.5px solid var(--linea);
        background:#fff;
        display:flex;
        align-items:center;
        justify-content:center;
        cursor:pointer;
        color:var(--ink);
        transition:background 0.15s ease, border-color 0.15s ease;
    }
    .icono-topbar:hover{ background:var(--azul-claro); border-color:var(--azul-seva); }
    .icono-topbar .punto-alerta{
        position:absolute;
        top:7px; right:8px;
        width:8px; height:8px;
        border-radius:50%;
        background:var(--verde-seva);
        border:2px solid #fff;
    }

    .menu-desplegable{
        position:absolute;
        top:calc(100% + 0.6rem);
        right:0;
        width:280px;
        background:#fff;
        border:1px solid var(--linea);
        border-radius:1rem;
        box-shadow:var(--sombra);
        padding:0.9rem;
        display:none;
        z-index:60;
    }
    .menu-desplegable.abierto{ display:block; }
    .menu-desplegable h4{
        font-size:0.95rem;
        margin-bottom:0.6rem;
        padding:0 0.3rem;
    }
    .item-notificacion{
        display:flex;
        gap:0.7rem;
        padding:0.6rem 0.3rem;
        border-radius:0.6rem;
        font-size:0.85rem;
        color:var(--texto);
    }
    .item-notificacion:hover{ background:var(--bg); }
    .item-notificacion .dot{
        width:8px; height:8px; border-radius:50%;
        background:var(--verde-seva);
        margin-top:0.35rem;
        flex-shrink:0;
    }
    .item-notificacion strong{ display:block; color:var(--ink); }
    .item-notificacion span.hora{ color:var(--muted); font-size:0.75rem; }

    .menu-perfil a{
        display:flex;
        align-items:center;
        gap:0.6rem;
        padding:0.65rem 0.5rem;
        border-radius:0.6rem;
        text-decoration:none;
        font-weight:600;
        font-size:0.9rem;
        color:var(--texto);
    }
    .menu-perfil a:hover{ background:var(--bg); }
    .menu-perfil hr{ border:none; border-top:1px solid var(--linea); margin:0.4rem 0; }

    /* =================== HERO =================== */
    .hero{
        display:grid;
        grid-template-columns:1.05fr 0.95fr;
        gap:3rem;
        align-items:center;
        padding:3.5rem 2.2rem 4rem;
        max-width:1280px;
        margin:0 auto;
        width:100%;
    }

    .eyebrow{
        display:inline-flex;
        align-items:center;
        gap:0.45rem;
        background:var(--verde-claro);
        color:#1c7a37;
        font-weight:700;
        font-size:0.82rem;
        padding:0.45rem 0.85rem;
        border-radius:2rem;
        margin-bottom:1.3rem;
    }

    .hero h1{
        font-size:clamp(2.1rem, 3.6vw, 3.1rem);
        font-weight:800;
        line-height:1.14;
        margin-bottom:1.1rem;
    }
    .hero h1 .resalte{ color:var(--azul-seva); }

    .hero p.desc{
        font-size:1.08rem;
        line-height:1.65;
        color:var(--muted);
        max-width:520px;
        margin-bottom:1.9rem;
    }

    .cta-fila{
        display:flex;
        flex-wrap:wrap;
        gap:0.9rem;
        margin-bottom:2.4rem;
    }
    .cta-fila .btn{ padding:0.95rem 1.6rem; font-size:1rem; }

    .prueba-social{
        display:flex;
        align-items:center;
        gap:0.9rem;
    }
    .avatares{
        display:flex;
    }
    .avatares span{
        width:38px; height:38px;
        border-radius:50%;
        border:3px solid #fff;
        margin-left:-12px;
        display:flex;
        align-items:center;
        justify-content:center;
        font-family:'Space Mono', monospace;
        font-weight:700;
        font-size:0.72rem;
        color:#fff;
    }
    .avatares span:first-child{ margin-left:0; }
    .avatares span:nth-child(1){ background:#0056b3; }
    .avatares span:nth-child(2){ background:#28a745; }
    .avatares span:nth-child(3){ background:#FFB84D; }
    .avatares span:nth-child(4){ background:#7A5CFA; }

    .prueba-texto .estrellas{
        color:var(--dorado);
        font-size:0.9rem;
        letter-spacing:0.1em;
        line-height:1;
        margin-bottom:0.2rem;
    }
    .prueba-texto p{
        margin:0;
        font-size:0.88rem;
        color:var(--muted);
        font-weight:600;
    }
    .prueba-texto p span.num{
        font-family:'Space Mono', monospace;
        color:var(--ink);
        font-weight:700;
    }

    /* =================== TARJETA DEMO (elemento firma) =================== */
    .tarjeta-demo{
        position:relative;
        border-radius:1.5rem;
        overflow:hidden;
        box-shadow:var(--sombra);
        background:linear-gradient(160deg, #10254A 0%, var(--ink) 65%, #08152B 100%);
        aspect-ratio:4/5;
        max-width:440px;
        margin:0 auto;
    }
    .tarjeta-demo::before{
        content:"";
        position:absolute;
        inset:0;
        background-image:radial-gradient(rgba(255,255,255,0.07) 1px, transparent 1px);
        background-size:24px 24px;
        opacity:0.6;
    }
    .escena-demo{
        position:absolute;
        inset:0;
        display:flex;
        align-items:center;
        justify-content:center;
    }
    .escena-demo svg{ width:88%; height:auto; }

    /* línea de escaneo del "hand-tracking" */
    .linea-escaneo{
        position:absolute;
        left:8%;
        right:8%;
        height:2px;
        background:linear-gradient(90deg, transparent, var(--verde-seva), transparent);
        box-shadow:0 0 14px 2px rgba(40,167,69,0.7);
        animation:escanear 3.2s ease-in-out infinite;
    }
    @keyframes escanear{
        0%   { top:18%; opacity:0; }
        10%  { opacity:1; }
        50%  { top:80%; opacity:1; }
        60%  { opacity:0; }
        100% { top:18%; opacity:0; }
    }

    .punto-rastreo{
        position:absolute;
        width:9px; height:9px;
        border-radius:50%;
        background:var(--verde-seva);
        box-shadow:0 0 0 5px rgba(40,167,69,0.22);
        animation:pulso-punto 2.4s ease-in-out infinite;
    }
    @keyframes pulso-punto{
        0%,100%{ transform:scale(1); }
        50%{ transform:scale(1.35); }
    }

    .insignia-precision{
        position:absolute;
        bottom:1.1rem;
        right:1.1rem;
        left:1.1rem;
        background:rgba(11,27,51,0.72);
        backdrop-filter:blur(6px);
        border:1px solid rgba(255,255,255,0.14);
        border-radius:1rem;
        padding:0.85rem 1rem;
        display:flex;
        align-items:center;
        gap:0.75rem;
        color:#fff;
    }
    .insignia-precision .icono-mano{
        width:36px; height:36px;
        border-radius:0.7rem;
        background:var(--verde-seva);
        display:flex;
        align-items:center;
        justify-content:center;
        flex-shrink:0;
    }
    .insignia-precision .texto strong{
        display:block;
        font-family:'Baloo 2', sans-serif;
        font-size:0.95rem;
    }
    .insignia-precision .texto .fila-precision{
        display:flex;
        align-items:center;
        gap:0.5rem;
        margin-top:0.3rem;
    }
    .insignia-precision .barra-precision{
        flex:1;
        height:6px;
        border-radius:1rem;
        background:rgba(255,255,255,0.18);
        overflow:hidden;
    }
    .insignia-precision .barra-precision-relleno{
        height:100%;
        background:var(--verde-seva);
        border-radius:1rem;
        transition:width 0.5s ease;
        width:98%;
    }
    .insignia-precision .valor-precision{
        font-family:'Space Mono', monospace;
        font-weight:700;
        font-size:0.85rem;
        color:#7CF29B;
        min-width:38px;
        text-align:right;
    }

    .chip-flotante-demo{
        position:absolute;
        top:1.1rem;
        left:1.1rem;
        background:rgba(255,255,255,0.1);
        border:1px solid rgba(255,255,255,0.2);
        color:#fff;
        font-family:'Space Mono', monospace;
        font-size:0.7rem;
        font-weight:700;
        letter-spacing:0.05em;
        text-transform:uppercase;
        padding:0.4rem 0.7rem;
        border-radius:0.5rem;
        display:flex;
        align-items:center;
        gap:0.4rem;
    }
    .chip-flotante-demo .punto-vivo{
        width:7px; height:7px;
        border-radius:50%;
        background:#7CF29B;
        animation:pulso-punto 1.6s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce){
        .linea-escaneo, .punto-rastreo, .chip-flotante-demo .punto-vivo{ animation:none; }
        html{ scroll-behavior:auto; }
    }

    /* =================== SECCIÓN CURSOS =================== */
    .seccion{
        padding:3.2rem 2.2rem;
        max-width:1280px;
        margin:0 auto;
        width:100%;
    }
    .cabecera-seccion{
        text-align:center;
        max-width:620px;
        margin:0 auto 2.4rem;
    }
    .cabecera-seccion .ojo{
        font-family:'Space Mono', monospace;
        font-size:0.78rem;
        font-weight:700;
        letter-spacing:0.14em;
        text-transform:uppercase;
        color:var(--azul-seva);
        margin-bottom:0.6rem;
        display:block;
    }
    .cabecera-seccion h2{
        font-size:2rem;
        margin-bottom:0.7rem;
    }
    .cabecera-seccion p{
        color:var(--muted);
        font-size:1rem;
        line-height:1.6;
    }

    .rejilla-cursos{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(240px, 1fr));
        gap:1.4rem;
    }
    .tarjeta-curso{
        background:#fff;
        border:1px solid var(--linea);
        border-radius:1.1rem;
        padding:1.5rem;
        transition:transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .tarjeta-curso:hover{
        transform:translateY(-5px);
        box-shadow:var(--sombra);
        border-color:var(--azul-seva);
    }
    .tarjeta-curso .icono-curso{
        width:52px; height:52px;
        border-radius:0.9rem;
        display:flex;
        align-items:center;
        justify-content:center;
        margin-bottom:1.1rem;
    }
    .tarjeta-curso h3{ font-size:1.1rem; margin-bottom:0.5rem; }
    .tarjeta-curso p{
        color:var(--muted);
        font-size:0.92rem;
        line-height:1.55;
        margin-bottom:1rem;
    }
    .tarjeta-curso a.enlace-curso{
        display:inline-flex;
        align-items:center;
        gap:0.35rem;
        font-weight:700;
        font-size:0.88rem;
        color:var(--azul-seva);
        text-decoration:none;
    }
    .tarjeta-curso a.enlace-curso:hover{ text-decoration:underline; }

    /* =================== POR QUÉ ELEGIR SEVA =================== */
    .seccion-porque{
        background:var(--ink);
        color:#EAF0FF;
        border-radius:2rem;
        margin:1.5rem 2.2rem 3rem;
        padding:3.5rem 2.2rem;
        max-width:1280px;
        margin-left:auto; margin-right:auto;
    }
    .seccion-porque .cabecera-seccion h2{ color:#fff; }
    .seccion-porque .cabecera-seccion p{ color:#B7C2E0; }
    .seccion-porque .cabecera-seccion .ojo{ color:#7CF29B; }

    .rejilla-porque{
        display:grid;
        grid-template-columns:repeat(auto-fit, minmax(220px, 1fr));
        gap:1.3rem;
    }
    .tarjeta-porque{
        background:rgba(255,255,255,0.05);
        border:1px solid rgba(255,255,255,0.1);
        border-radius:1.1rem;
        padding:1.5rem;
    }
    .tarjeta-porque .icono-porque{
        width:46px; height:46px;
        border-radius:0.8rem;
        background:rgba(40,167,69,0.18);
        color:#7CF29B;
        display:flex;
        align-items:center;
        justify-content:center;
        margin-bottom:1rem;
    }
    .tarjeta-porque h3{ color:#fff; font-size:1.02rem; margin-bottom:0.4rem; }
    .tarjeta-porque p{ color:#B7C2E0; font-size:0.88rem; line-height:1.55; margin:0; }

    /* estadísticas */
    .fila-stats{
        display:grid;
        grid-template-columns:repeat(3, 1fr);
        gap:1rem;
        margin-top:2.4rem;
        padding-top:2.2rem;
        border-top:1px solid rgba(255,255,255,0.1);
        text-align:center;
    }
    .fila-stats .stat strong{
        display:block;
        font-family:'Space Mono', monospace;
        font-size:1.9rem;
        color:#7CF29B;
    }
    .fila-stats .stat span{
        font-size:0.85rem;
        color:#B7C2E0;
    }

    /* =================== FOOTER =================== */
    footer{
        background:#fff;
        border-top:1px solid var(--linea);
        padding:2.4rem 2.2rem 2rem;
        text-align:center;
        color:var(--muted);
        font-size:0.88rem;
    }
    footer .marca-pie{
        font-family:'Baloo 2', sans-serif;
        font-weight:800;
        color:var(--ink);
        font-size:1.1rem;
        margin-bottom:0.4rem;
    }
    footer a{ color:var(--azul-seva); text-decoration:none; font-weight:600; }
    footer a:hover{ text-decoration:underline; }

    /* =================== MODAL "Ver cómo funciona" =================== */
    .fondo-modal{
        position:fixed;
        inset:0;
        background:rgba(11,27,51,0.6);
        display:none;
        align-items:center;
        justify-content:center;
        padding:1.5rem;
        z-index:100;
    }
    .fondo-modal.abierto{ display:flex; }
    .modal{
        background:#fff;
        border-radius:1.4rem;
        max-width:520px;
        width:100%;
        padding:2rem;
        position:relative;
        box-shadow:var(--sombra);
    }
    .modal .cerrar-modal{
        position:absolute;
        top:1rem; right:1rem;
        width:38px; height:38px;
        border-radius:0.6rem;
        border:1.5px solid var(--linea);
        background:#fff;
        cursor:pointer;
        display:flex;
        align-items:center;
        justify-content:center;
        color:var(--ink);
    }
    .modal .cerrar-modal:hover{ background:var(--bg); }
    .modal h3{ font-size:1.4rem; margin-bottom:0.3rem; padding-right:2rem; }
    .modal p.sub{ color:var(--muted); margin-bottom:1.4rem; font-size:0.95rem; }
    .pasos-modal{ list-style:none; padding:0; margin:0 0 1.6rem; display:flex; flex-direction:column; gap:1rem; }
    .pasos-modal li{ display:flex; gap:0.9rem; }
    .pasos-modal .num{
        width:32px; height:32px; flex-shrink:0;
        border-radius:50%;
        background:var(--azul-claro);
        color:var(--azul-seva);
        font-family:'Space Mono', monospace;
        font-weight:700;
        display:flex; align-items:center; justify-content:center;
        font-size:0.85rem;
    }
    .pasos-modal strong{ display:block; font-size:0.95rem; color:var(--ink); margin-bottom:0.15rem; }
    .pasos-modal span{ font-size:0.87rem; color:var(--muted); line-height:1.5; }

    /* =================== RESPONSIVE =================== */
    @media (max-width: 1080px){
        .hero{ grid-template-columns:1fr; }
        .tarjeta-demo{ max-width:380px; }
    }

    @media (max-width: 900px){
        .app{ grid-template-columns:1fr; }
        .sidebar{
            position:fixed;
            left:0; top:0;
            width:280px;
            transform:translateX(-100%);
            transition:transform 0.2s ease;
        }
        .sidebar.abierto{ transform:translateX(0); }
        .fondo-sidebar-movil.abierto{ display:block; }
        .btn-menu{ display:flex; }
        .topbar{ padding:1rem 1.3rem; }
        .buscador{ max-width:none; }
    }

    @media (max-width: 560px){
        .hero{ padding:2.4rem 1.3rem 3rem; }
        .seccion{ padding:2.4rem 1.3rem; }
        .seccion-porque{ margin:1rem 0.6rem 2.4rem; padding:2.4rem 1.3rem; border-radius:1.4rem; }
        .fila-stats{ grid-template-columns:1fr; gap:1.3rem; }
        .cta-fila .btn{ width:100%; }
        .prueba-social{ flex-wrap:wrap; }
        .topbar-derecha .icono-topbar:nth-child(1){ display:none; } /* mantiene compacto en móvil */
    }
</style>
</head>
<body>

<a href="#contenido" class="skip-link">Saltar al contenido</a>

<div class="app">

    <!-- ================= SIDEBAR ================= -->
    <aside class="sidebar" id="sidebar">
        <a href="#inicio" class="marca"><span class="punto"></span>Seva</a>

