<file path="DataBase/migrations/001_intentos_login.sql">
-- =============================================================================
-- SEVA - Migración 001: tabla de control de intentos de inicio de sesión
-- =============================================================================
-- Fase 3 (D09): anti fuerza bruta.
-- Idempotente: puede ejecutarse varias veces sin error.
--
-- Uso:
--   mysql -u root -h 127.0.0.1 sevaeducativo < DataBase/migrations/001_intentos_login.sql
-- =============================================================================

CREATE TABLE IF NOT EXISTS `intentos_login` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `ip` varchar(45) NOT NULL,
  `email` varchar(150) NOT NULL,
  `intentos` int(11) NOT NULL DEFAULT 0,
  `bloqueado_hasta` datetime DEFAULT NULL,
  `actualizado` timestamp NOT NULL DEFAULT current_timestamp() ON UPDATE current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_ip_email` (`ip`,`email`),
  KEY `idx_actualizado` (`actualizado`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
</file>

<file path="DataBase/migrations/002_recuperacion_password.sql">
-- =============================================================================
-- SEVA - Migración 002: tabla de recuperación de contraseña
-- =============================================================================
-- Fase 5 (D13): flujo de restablecimiento con tokens de un solo uso.
-- Idempotente: puede ejecutarse varias veces sin error.
--
-- Uso:
--   mysql -u root -h 127.0.0.1 sevaeducativo < DataBase/migrations/002_recuperacion_password.sql
--   mysql -u root -h 127.0.0.1 seva_educativo_test < DataBase/migrations/002_recuperacion_password.sql
--
-- Seguridad:
--   * Nunca se almacena el token en claro: solo su hash SHA-256 (64 hex).
--   * Un token caduca a los 30 minutos (lo fija la aplicación) y es de un solo uso.
--   * Al eliminar el usuario, sus tokens se eliminan en cascada.
-- =============================================================================

CREATE TABLE IF NOT EXISTS `recuperacion_password` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `id_usuario` int(11) NOT NULL,
  `token_hash` char(64) NOT NULL,
  `expira` datetime NOT NULL,
  `usado` tinyint(1) NOT NULL DEFAULT 0,
  `creado_en` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_token_hash` (`token_hash`),
  KEY `idx_id_usuario` (`id_usuario`),
  KEY `idx_expira` (`expira`),
  CONSTRAINT `fk_recuperacion_usuario` FOREIGN KEY (`id_usuario`)
    REFERENCES `usuarios` (`id_usuario`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
</file>

<file path="DataBase/migrations/003_vocabulario_senas.sql">
-- =============================================================================
-- SEVA - Migración 003: vocabulario de señas por lección
-- =============================================================================
-- Fase 6 (D16): sustituye el vocabulario hardcodeado (siempre "Saludos") por
-- contenido propio de cada lección.
-- Idempotente: puede ejecutarse varias veces sin error.
--
-- Uso:
--   mysql -u root -h 127.0.0.1 sevaeducativo < DataBase/migrations/003_vocabulario_senas.sql
--   mysql -u root -h 127.0.0.1 seva_educativo_test < DataBase/migrations/003_vocabulario_senas.sql
--
-- Nota: esta migración solo crea la estructura. Los datos de demostración se
-- cargan con DataBase/seed_demo.sql (sección "Vocabulario de señas").
-- =============================================================================

CREATE TABLE IF NOT EXISTS `vocabulario_senas` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `contenido_id` int(11) NOT NULL,
  `palabra` varchar(100) NOT NULL,
  `descripcion` text NOT NULL,
  `orden` int(11) NOT NULL DEFAULT 0,
  PRIMARY KEY (`id`),
  UNIQUE KEY `uk_contenido_palabra` (`contenido_id`, `palabra`),
  KEY `idx_contenido_orden` (`contenido_id`, `orden`),
  CONSTRAINT `fk_vocabulario_contenido` FOREIGN KEY (`contenido_id`)
    REFERENCES `contenidos_educativos` (`id`) ON DELETE CASCADE ON UPDATE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
</file>

